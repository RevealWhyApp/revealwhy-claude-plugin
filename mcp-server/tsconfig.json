{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "comment": "g3-agent.ts / harness-builder.ts are tsx-run G3 harnesses, not part of the published server.",
  "exclude": ["node_modules", "dist", "src/g3-agent.ts", "src/harness-builder.ts"]
}
